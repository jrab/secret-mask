{
  "name": "secret-mask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run check && node esbuild.config.mjs",
    "check": "tsc --noEmit && eslint . --max-warnings 0",
    "release:check": "node scripts/check-release.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "27.0.1",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
